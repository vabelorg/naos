# Build-time script run after each build of a test executable (see Naos.cmake). Lists the tests
# with "<exe> --naos-list" and writes the CTest file registering one CTest test per Naos test.
#
# Input: -D NAOS_PARAMS=<file>, written by _naos_discovery_params() of Naos.cmake, defining
#   NAOS_TARGET             name of the target, for messages
#   NAOS_EXECUTABLE         path of the executable
#   NAOS_EMULATOR           command line run in front of it, or empty
#   NAOS_PREFIX             prefix of the CTest names
#   NAOS_LABELS             labels of the CTest tests, or empty
#   NAOS_PROPERTIES         other properties of the CTest tests, <name> <value> pairs, or empty
#   NAOS_DISCOVERY_TIMEOUT  limit of the listing, in seconds
#   NAOS_OUTPUT             the CTest file to write

cmake_minimum_required(VERSION 3.21)

# Quotes value as a bracket argument for the generated file.
function(naos_quote out value)
    set(${out} "[==[${value}]==]" PARENT_SCOPE)
endfunction()

# Quotes each item of the list variable list_var, each after a space.
function(naos_quote_list out list_var)
    set(quoted_list "")
    foreach(item IN LISTS ${list_var})
        naos_quote(quoted "${item}")
        string(APPEND quoted_list " ${quoted}")
    endforeach()
    set(${out} "${quoted_list}" PARENT_SCOPE)
endfunction()

# Sets out to what to do about a listing that ended with result and printed output.
function(naos_listing_hint out result output)
    if(result MATCHES "timeout")
        string(CONCAT hint "Listing the tests did not finish within the limit of ${NAOS_DISCOVERY_TIMEOUT} s. If it is only slow, "
            "raise the limit with DISCOVERY_TIMEOUT <seconds> of naos_add_executable() or naos_discover_tests().")
    else()
        # Windows reports STATUS_DLL_NOT_FOUND with no output; the loaders of Linux and macOS print these.
        if((result MATCHES "0[xX][cC]0000135")
           OR (output MATCHES "error while loading shared libraries|Library not loaded"))
            set(hint "The executable could not start because a shared library (DLL) was not found. To fix it, ")
        else()
            set(hint "If the executable could not start because a shared library (DLL) was not found, ")
        endif()
        string(APPEND hint "put the library next to the executable (it runs right after the build, before "
            "any install), or make it findable at build time: add its directory to PATH on Windows, "
            "LD_LIBRARY_PATH on Linux or DYLD_LIBRARY_PATH on macOS, or give the executable an rpath.")
    endif()
    set(${out} "${hint}" PARENT_SCOPE)
endfunction()

# Sets out to the names the executable lists, failing when it cannot list them.
function(naos_list_tests out)
    execute_process(
        COMMAND ${NAOS_EMULATOR} "${NAOS_EXECUTABLE}" --naos-list
        OUTPUT_VARIABLE list_output
        ERROR_VARIABLE list_error
        RESULT_VARIABLE list_result
        TIMEOUT ${NAOS_DISCOVERY_TIMEOUT}
    )
    if(NOT list_result EQUAL 0)
        set(output "${list_output}${list_error}")
        naos_listing_hint(hint "${list_result}" "${output}")
        message(FATAL_ERROR "Failed to list the tests of ${NAOS_TARGET} (result: ${list_result})\n${output}${hint}")
    endif()

    string(REPLACE "\r" "" list_output "${list_output}")
    string(REPLACE "\n" ";" lines "${list_output}")
    set(names "")
    foreach(line IN LISTS lines)
        if(line STREQUAL "")
            continue()
        endif()
        # naos_run() accepts only these names, which --naos-filter selects one by one.
        if(NOT line MATCHES "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$")
            message(FATAL_ERROR "Invalid test name in ${NAOS_TARGET}: '${line}'")
        endif()
        list(APPEND names "${line}")
    endforeach()
    set(${out} "${names}" PARENT_SCOPE)
endfunction()

if(NOT DEFINED NAOS_PARAMS)
    message(FATAL_ERROR "NAOS_PARAMS is not set")
endif()
include("${NAOS_PARAMS}")
foreach(name IN ITEMS NAOS_TARGET NAOS_EXECUTABLE NAOS_EMULATOR NAOS_PREFIX NAOS_LABELS
        NAOS_PROPERTIES NAOS_DISCOVERY_TIMEOUT NAOS_OUTPUT)
    if(NOT DEFINED ${name})
        message(FATAL_ERROR "${NAOS_PARAMS} does not set ${name}")
    endif()
endforeach()

if(NOT EXISTS "${NAOS_EXECUTABLE}")
    message(FATAL_ERROR "Test executable not found: ${NAOS_EXECUTABLE}")
endif()

naos_list_tests(test_names)

naos_quote_list(emulator_args NAOS_EMULATOR)
naos_quote(executable "${NAOS_EXECUTABLE}")
naos_quote_list(property_args NAOS_PROPERTIES)
if(NOT NAOS_LABELS STREQUAL "")
    naos_quote(quoted "${NAOS_LABELS}")
    string(APPEND property_args " LABELS ${quoted}")
endif()

set(content "# Generated by NaosDiscover.cmake for ${NAOS_TARGET}. Do not edit.\n")
foreach(test_name IN LISTS test_names)
    naos_quote(ctest_name "${NAOS_PREFIX}${test_name}")
    naos_quote(filter "${test_name}")
    string(APPEND content "add_test(${ctest_name}${emulator_args} ${executable} --naos-filter ${filter})\n")
    string(APPEND content "set_tests_properties(${ctest_name} PROPERTIES SKIP_RETURN_CODE 77${property_args})\n")
endforeach()

file(WRITE "${NAOS_OUTPUT}" "${content}")
